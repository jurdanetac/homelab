[Unit]
Description=mergerfs service
After=patriot-240.service toshiba-500.service seagate-320.service toshiba-320.service
Wants=patriot-240.service toshiba-500.service seagate-320.service toshiba-320.service

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p /mnt/mergerfs
ExecStart=/usr/bin/mergerfs -f \
  -o cache.files=partial,dropcacheonclose=false,allow_other \
  -o category.create=epmfs,minfreespace=20G,func.getattr=newest \
  /mnt/seagate-320:/mnt/toshiba-500:/mnt/toshiba-320:/mnt/patriot-240 /mnt/mergerfs
ExecStop=/usr/bin/fusermount -u /mnt/mergerfs
Restart=on-failure
KillMode=mixed

[Install]
WantedBy=multi-user.target
