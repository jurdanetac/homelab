[Unit]
Description=Late Unlock and Mount of Patriot Burst Elite 240GB HDD
After=local-fs.target
Requires=local-fs.target

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 2
ExecStartPre=/usr/bin/mkdir -p /mnt/patriot-240
ExecStart=/bin/sh -c 'if ! /sbin/cryptsetup status patriot-240-mapper >/dev/null 2>&1; then /sbin/cryptsetup open UUID=9393b113-3d83-433c-bcc1-e10ce63081b4 patriot-240-mapper --key-file=/etc/cryptsetup-keys.d/patriot-240.keyfile; fi'
ExecStartPost=/bin/sh -c 'mountpoint -q /mnt/patriot-240 || /usr/bin/mount /dev/mapper/patriot-240-mapper /mnt/patriot-240'
ExecStop=/usr/bin/umount /mnt/patriot-240
ExecStopPost=/sbin/cryptsetup close patriot-240-mapper
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
