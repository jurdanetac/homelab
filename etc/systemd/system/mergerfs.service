[Unit]
Description=mergerfs service
After=sandisk-500.service toshiba-500.service seagate-320.service toshiba-320.service
Wants=sandisk-500.service toshiba-500.service seagate-320.service toshiba-320.service

[Service]
Type=simple
ExecStartPre=/usr/bin/mkdir -p /mnt/mergerfs
ExecStart=/usr/bin/mergerfs -f \
  -o rw,allow_other,cache.files=partial,dropcacheonclose=false \
  -o func.getattr=newest,category.create=mfs,minfreespace=20G \
  /mnt/seagate-320:/mnt/toshiba-500:/mnt/toshiba-320:/mnt/sandisk-500 /mnt/mergerfs
ExecStop=/usr/bin/fusermount -u /mnt/mergerfs
Restart=on-failure
KillMode=mixed

[Install]
WantedBy=multi-user.target
